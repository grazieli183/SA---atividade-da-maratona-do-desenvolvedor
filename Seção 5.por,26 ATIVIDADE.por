programa {
  funcao inicio() {
    cadeia senha, x

    escreva ("Digite a senha de entrada: \n")
    leia (senha)

    x ="SENAI123"

    enquanto (senha != x){
     se ( senha != x)
     escreva ("Senha incorreta. Tente novamente \n")
   
   senao
    escreva("Sua senha está correta")
    }

    escreva ("Senha correta!")

  }
}
